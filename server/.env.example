DATABASE_URL=postgres://user:pass@host/db?sslmode=require
PORT=8787
CORS_ORIGIN=http://localhost:5173

# Optional stats enrichment (minutes/goals/assists) for the auction role
# comparison. Off by default; the base comparison never depends on it.
STATS_API_ENABLED=false
STATS_API_KEY=
STATS_API_BASE_URL=https://v3.football.api-sports.io

# Probabili formazioni: estrazione da screenshot via Claude (vision), backend
# only. Senza chiave l'endpoint di extract risponde 503, ma nessun'altra
# funzionalità dell'app ne dipende.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_BASE_URL=https://api.anthropic.com

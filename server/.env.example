DATABASE_URL=postgres://user:pass@host/db?sslmode=require
PORT=8787
CORS_ORIGIN=http://localhost:5173

# Optional stats providers for the auction role comparison. Both are off by
# default and cost nothing when disabled; the base comparison never depends on
# either, and no data is ever invented when a provider is off or unmatched.

# API-Football — real performance (minutes/goals/assists), live season.
STATS_API_ENABLED=false
STATS_API_KEY=
STATS_API_BASE_URL=https://v3.football.api-sports.io

# SoFIFA — EA FC attributes (overall/potential/age/FIFA value). A different data
# axis, not a replacement for API-Football. The public /player/{id} endpoint
# needs no auth; attributes only load for players whose sofifa_id is mapped (see
# the db:seed:sofifa script). Attribution to SoFIFA is required where shown.
SOFIFA_ENABLED=false
SOFIFA_BASE_URL=https://api.sofifa.net
# Optional: only needed for the customizedPlayers endpoints (a user's own edited
# players), not for standard attribute lookups. Backend-only if ever set.
SOFIFA_API_TOKEN=
# Used only by db:seed:sofifa to map player.sofifa_id from Serie A squads.
# SOFIFA_ROSTER is the dataset version id (changes per SoFIFA update; read it
# from the roster picker on sofifa.com). SOFIFA_LEAGUE_ID defaults to 31 (Serie A).
SOFIFA_LEAGUE_ID=31
SOFIFA_ROSTER=

# Probabili formazioni: estrazione da screenshot via Claude (vision), backend
# only. Senza chiave l'endpoint di extract risponde 503, ma nessun'altra
# funzionalità dell'app ne dipende.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_BASE_URL=https://api.anthropic.com

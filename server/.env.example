DATABASE_URL=postgres://user:pass@host/db?sslmode=require
PORT=8787
CORS_ORIGIN=http://localhost:5173

# Sessione auth: cookie firmato httpOnly, nessuna tabella sessioni (stateless).
COOKIE_SECRET=change-me-to-a-long-random-string
# true sia in dev sia in prod: entrambi soddisfano il requisito "secure
# context" del browser per i cookie Secure (localhost è trattato come
# trustworthy anche su http). Impostare false solo per testare da un
# dispositivo in rete locale via IP non-localhost.
COOKIE_SECURE=true

# Optional stats providers for the auction role comparison. Both are off by
# default and cost nothing when disabled; the base comparison never depends on
# either, and no data is ever invented when a provider is off or unmatched.

# API-Football — real performance (minutes/goals/assists), live season.
STATS_API_ENABLED=false
STATS_API_KEY=
STATS_API_BASE_URL=https://v3.football.api-sports.io

# SoFIFA — EA FC attributes (overall/potential/age/FIFA value). A different data
# axis, not a replacement for API-Football. IMPORTANT: api.sofifa.net is NOT
# public — it is whitelist-only, so calls 403 (→ no data, no regression) until
# SoFIFA whitelists your caller. Leave OFF unless you have whitelisted access.
# When enabled and whitelisted, attributes load only for players whose sofifa_id
# is mapped (see db:seed:sofifa). Attribution to SoFIFA is required where shown.
SOFIFA_ENABLED=false
SOFIFA_BASE_URL=https://api.sofifa.net
# Kept for a possible token-based whitelist scheme; not currently sent (SoFIFA
# has not specified how a token is passed). Backend-only if ever set.
SOFIFA_API_TOKEN=
# Config for db:seed:sofifa (maps player.sofifa_id from Serie A squads).
# SOFIFA_SQUADS_FILE: optional path to a pre-collected squads JSON
#   ([{ "sofifaId", "name", "team" }, ...]) — use it when the live API is not
#   reachable/whitelisted. When set, the API crawl below is skipped.
# SOFIFA_ROSTER: dataset version id (changes per update). SOFIFA_LEAGUE_ID = 31.
SOFIFA_SQUADS_FILE=
SOFIFA_LEAGUE_ID=31
SOFIFA_ROSTER=260046

# Probabili formazioni: estrazione da screenshot via Claude (vision), backend
# only. Senza chiave l'endpoint di extract risponde 503, ma nessun'altra
# funzionalità dell'app ne dipende.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_BASE_URL=https://api.anthropic.com

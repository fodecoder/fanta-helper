{
  "name": "server",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --noEmit && tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:migrate": "node-pg-migrate up",
    "db:migrate:down": "node-pg-migrate down",
    "db:migrate:create": "node-pg-migrate -j sql create",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@fanta-helper/shared": "*",
    "@types/cors": "^2.8.19",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.2",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "pg": "^8.23.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.21.0",
    "node-pg-migrate": "^9.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12"
  }
}

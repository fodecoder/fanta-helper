{
  "name": "fanta-helper",
  "version": "4.5.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "workspaces": [
    "web",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm:dev --workspace server\" \"npm:dev --workspace web\"",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint . && npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "npm run db:migrate --workspace server",
    "db:seed": "npm run db:seed --workspace server",
    "db:seed:users": "npm run db:seed:users --workspace server",
    "db:seed:sofifa": "npm run db:seed:sofifa --workspace server",
    "db:seed:historical": "npm run db:seed:historical --workspace server",
    "db:seed:historical:quotations": "npm run db:seed:historical:quotations --workspace server",
    "db:seed:historical:stats": "npm run db:seed:historical:stats --workspace server",
    "db:seed:historical:rigoristi": "npm run db:seed:historical:rigoristi --workspace server",
    "db:seed:historical:formazioni": "npm run db:seed:historical:formazioni --workspace server"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
